# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration. Never prefix the service-role key with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Existing optional server-side AI Tutor integration. Leave blank to keep AI calls disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional operational email notification for stored enquiries.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VIDYAMENTOR AI <noreply@your-domain.com>
LEADS_TO_EMAIL=
